{
  "name": "plume-travel",
  "private": true,
  "version": "0.1.0",
  "description": "Plume Travel front end with mock data (UI approval stage). Mirrors the Plume app stack: React 19, TypeScript, Tailwind v4, TanStack Router, lucide-react.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/artifact.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.1",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vite-plugin-singlefile": "2.3.0"
  }
}
